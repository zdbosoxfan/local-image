[Desktop Entry]
Type=Application
Name=Local Image
GenericName=Image Editor
Comment=Edit, catalogue and generate images with local AI
Exec=local-image %F
Icon=io.github.zdbosoxfan.LocalImage
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;

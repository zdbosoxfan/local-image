+#[test]
+fn local_image_display_surface_negotiation() {
+    use wgpu::TextureFormat::{Bgra8Unorm, Rgb10a2Unorm};
+    let mut config = WgpuConfiguration { preferred_formats: vec![Rgb10a2Unorm], ..Default::default() };
+    assert_eq!(config.framebuffer_format(&[Bgra8Unorm, Rgb10a2Unorm]).unwrap(), Rgb10a2Unorm);
+    assert_eq!(config.framebuffer_format(&[Bgra8Unorm]).unwrap(), Bgra8Unorm);
+    config.preferred_formats.clear(); // forced 8-bit application configuration
+    assert_eq!(config.framebuffer_format(&[Bgra8Unorm, Rgb10a2Unorm]).unwrap(), Bgra8Unorm);
+    assert!(config.framebuffer_format(&[]).is_err());
+}

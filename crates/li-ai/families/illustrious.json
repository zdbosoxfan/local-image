{
  "schema": 1,
  "version": 1,
  "id": "illustrious",
  "base": "sdxl",
  "label": "Illustrious / NoobAI",
  "group": "Stable Diffusion",
  "description": "SDXL fine-tunes for illustration and anime (Illustrious XL, NoobAI); tag prompts with quality tags.",
  "pipeline": {
    "clip": {
      "node": "checkpoint",
      "skip": -2
    },
    "sampler_name": "euler_ancestral",
    "scheduler": "normal"
  },
  "sampling": {
    "steps": {
      "default": 28,
      "min": 1,
      "max": 100
    },
    "cfg": {
      "default": 5.5,
      "min": 1,
      "max": 20
    },
    "denoise": 0.6
  },
  "lora": {
    "loader": "LoraLoader",
    "compatible": [
      "illustrious",
      "sdxl"
    ],
    "max": 5
  },
  "prompt": {
    "prefix": "masterpiece, best quality, ",
    "negative": "worst quality, low quality, lowres, bad anatomy, watermark"
  },
  "license": "Fair AI Public License 1.0-SD",
  "license_url": "https://huggingface.co/OnomaAIResearch/Illustrious-xl-early-release-v0",
  "civitai_base_models": [
    "Illustrious",
    "NoobAI"
  ],
  "hf_tags": [
    "illustrious"
  ],
  "models": []
}

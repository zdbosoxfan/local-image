[Desktop Entry]
Type=Application
Name=Local Image
GenericName=Image Editor
Comment=Edit, catalogue and generate images with local AI
Exec=local-image %F
Icon=io.github.zdbosoxfan.LocalImage
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
MimeType=image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-exr;image/vnd.adobe.photoshop;image/x-tga;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-sony-arw;image/x-adobe-dng;image/x-fuji-raf;image/x-panasonic-rw2;image/x-olympus-orf;image/apng;image/heif;image/jxl;image/svg+xml;image/svg+xml-compressed;application/pdf;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/qoi;image/x-nikon-nrw;image/x-panasonic-rw;image/x-pentax-pef;image/x-sigma-x3f;image/x-sony-srf;image/x-sony-sr2;image/x-kodak-kdc;image/x-kodak-dcr;image/x-minolta-mrw;image/x-canon-crw;application/x-local-image-document;

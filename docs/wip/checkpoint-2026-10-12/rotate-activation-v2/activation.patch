diff --git a/crates/pc-ui-egui/src/ai_remove_ui/tests.rs b/crates/pc-ui-egui/src/ai_remove_ui/tests.rs
index ae9db0fa..632571f4 100644
--- a/crates/pc-ui-egui/src/ai_remove_ui/tests.rs

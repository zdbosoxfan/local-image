+        assert!(h.state().ai_remove.is_none());
+        let st = h.state().session.active().unwrap();
+        assert!(std::sync::Arc::ptr_eq(&doc, &st.doc));
+        assert_eq!((st.revision, st.history.past_len()), (revision, history));
+    }
+}

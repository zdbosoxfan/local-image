+#[test]
+fn geometry_follows_combine_and_dialog_aliases_do_not_duplicate_visible_commands() {
+    let app = app(false);
+    let items = menu_items(&app);
+    let layer: Vec<_> = items.iter().filter(|i| i.path.first().is_some_and(|p| p == "Layer")).collect();
+    assert_eq!(layer[0].path.get(1).map(String::as_str), Some("New"));
+    let combine = layer.iter().rposition(|i| i.path.get(1).is_some_and(|p| p == "Combine Shapes")).unwrap();
+    assert_eq!(layer[combine + 1].path, ["Layer", "Geometry"]);
+    assert_eq!(items.iter().filter(|i| i.id == "li.draftRefine").count(), 1);
+    assert!(!items.iter().any(|i| i.id == "edit.preferences.integrations"));
+    assert!(is_live("edit.preferences.integrations"), "old custom shortcut/automation alias remains valid");
+    assert!(items.iter().any(|i| i.id == "li.localAi" && i.enabled));
+    let ordinary = items.iter().find(|i| i.id == "select.subject").unwrap();
+    let matte = items.iter().find(|i| i.id == "ai.selectSubject").unwrap();
+    assert_ne!(ordinary.label, matte.label);
+    assert!(ordinary.tooltip.as_ref().unwrap().contains("on-device"));
+    assert!(matte.tooltip.as_ref().unwrap().contains("matte"));
+}

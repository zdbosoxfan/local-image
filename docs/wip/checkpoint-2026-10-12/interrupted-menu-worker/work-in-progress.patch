+#[test]
+fn vector_panels_are_persona_scoped_toggle_and_have_no_import_placeholders() {
+    let mut h = harness(true, 1600.0, false);
+    for vector in [false, true] {
+        h.state_mut().session.edit_prefs(|p| p.toolbar.persona = if vector { Persona::Vector } else { Persona::Pixel });
+        let rows = menu_items(h.state());
+        assert!(!rows.iter().any(|i| matches!(i.id.as_str(), "window.vector.SVG Import" | "window.vector.Affinity Import")));
+        assert_eq!(rows.iter().filter(|i| i.id.starts_with("window.vector.")).count(), if vector { 6 } else { 0 });
+        assert_eq!(rows.iter().any(|i| i.id == "ui.vector.layout"), vector);
+    }
+    h.run_steps(3);
+    h.get_by_label("Window").click();
+    h.run_steps(3);
+    choose(&mut h, 0, "window.vector.Appearance");
+    assert!(crate::vector_integration::open_panels_for_test(h.state()).contains("Appearance"));
+    assert_eq!(menu_items(h.state()).iter().find(|i| i.id == "window.vector.Appearance").unwrap().checked, Some(true));
+    let ctx = h.ctx.clone();
+    invoke(h.state_mut(), &ctx, "window.vector.Appearance", json!({})).unwrap();
+    assert!(!crate::vector_integration::open_panels_for_test(h.state()).contains("Appearance"));
+}

+#[test]
+fn small_pixel_sets_do_not_append_extras_but_all_custom_and_active_tools_keep_them() {
+    let mut app = app(false);
+    let tools = |app: &PhotocraftApp| crate::panels::visible_sections(app).into_iter().flatten().flat_map(|(_, tools)| tools).collect::<Vec<_>>();
+    let shared: Vec<_> = photocraft_engine::shared_tools::SHARED_ADDITIONS.iter().filter_map(|id| crate::state::Tool::from_name(id)).collect();
+    app.ui.tool = crate::state::Tool::Move;
+    for id in ["photographer", "essentials", "retouching", "ai"] {
+        app.run("toolset.select", json!({"id":id})).unwrap();
+        assert!(!tools(&app).iter().any(|tool| shared.contains(tool)), "{id} gained extra vector slots");
+    }
+    app.run("toolset.select", json!({"id":"allTools"})).unwrap();
+    for tool in &shared {
+        assert!(tools(&app).contains(tool), "All Tools lost {tool:?}");
+    }
+    app.run("toolset.save", json!({"name":"Intentional extra", "tools":["Move","ArtText","VectorPencil"]})).unwrap();
+    assert!(tools(&app).contains(&crate::state::Tool::ArtText));
+    assert!(tools(&app).contains(&crate::state::Tool::VectorPencil));
+    app.run("toolset.select", json!({"id":"photographer"})).unwrap();
+    app.ui.tool = crate::state::Tool::VectorPencil;
+    assert!(tools(&app).contains(&crate::state::Tool::VectorPencil), "shortcut-selected tool remains visible");
+}

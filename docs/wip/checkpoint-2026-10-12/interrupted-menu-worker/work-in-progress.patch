+    let items = menu_items(&app);
+    let tree = crate::native_menu::photocraft_layout(&items, crate::i18n::Lang::EN, "auto");
+    let names: Vec<_> = tree.bar.menus.iter().map(|menu| menu.title.as_str()).collect();
+    assert!(names.iter().position(|name| *name == "Object").unwrap() < names.iter().position(|name| *name == "Type").unwrap());
+    assert_eq!(names.last(), Some(&"Help"));
+    assert!(tree.bar.find("ui.vector.view.xray").is_some());
+    assert_eq!(items.iter().find(|i| i.id == "ui.vector.view.xray").unwrap().shortcut.as_deref(), Some("Cmd+Alt+9"));
+    assert!(items.iter().any(|i| i.id == "view.resetRotation"), "Rotate rows retained");
+}

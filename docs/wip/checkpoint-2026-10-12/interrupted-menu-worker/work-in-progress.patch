+//! Original U018–U023/U031: real menu input, retained command routes and compact chrome.
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+use super::*;
+use egui_kittest::{Harness, kittest::Queryable};
+use photocraft_engine::toolsets::Persona;
+
+fn app(vector: bool) -> PhotocraftApp {
+    let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), Default::default());
+    app.run("file.new", json!({"width":64,"height":48})).unwrap();
+    app.sync_views();
+    app.session.edit_prefs(|p| p.toolbar.persona = if vector { Persona::Vector } else { Persona::Pixel });
+    app
+}
+fn harness(vector: bool, width: f32, compact: bool) -> Harness<'static, PhotocraftApp> {
+    let mut h = Harness::builder().with_size(egui::vec2(width, 480.0)).build_ui_state(
+        move |ui, app| {
+            menu_bar_with_width(app, ui, if compact { 90.0 } else { width });
+        },
+        app(vector),
+    );
+    PhotocraftApp::setup_context(&h.ctx, crate::theme::ThemeKind::Studio);
+    h.ctx.all_styles_mut(|style| style.scroll_animation = egui::style::ScrollAnimation::none());
+    h.run_steps(3);
+    h
+}
+fn key(h: &mut Harness<'static, PhotocraftApp>, key: egui::Key) {
+    h.key_press(key);
+    h.run_steps(3);
+}
+fn choose(h: &mut Harness<'static, PhotocraftApp>, level: usize, id: &str) {
+    let count = crate::menu_nav::Nav::current(&h.ctx).rows[level].len();
+    for _ in 0..=count {
+        key(h, egui::Key::ArrowDown);
+        let nav = crate::menu_nav::Nav::current(&h.ctx);
+        if nav.highlighted(level).is_some_and(|i| nav.rows[level][i].command.as_deref() == Some(id)) {
+            key(h, egui::Key::Enter);
+            return;
+        }
+    }
+    panic!("keyboard could not reach {id}");
+}
+
+#[test]
+fn vector_roots_are_ordered_help_last_and_registered_views_work_by_keyboard() {
+    let mut h = harness(true, 1600.0, false);
+    let items = menu_items(h.state());
+    assert_eq!(top_menu_titles(&items), VECTOR_TOP_MENUS);
+    let mut right = 0.0;
+    for title in VECTOR_TOP_MENUS {
+        let rect = h.get_by_label(title).rect();
+        assert!(rect.left() >= right);
+        right = rect.right();
+    }
+    assert!(h.query_by_label("Vector").is_none(), "no separate keyboard-inaccessible menu bar");
+    h.get_by_label("View").click();
+    h.run_steps(3);
+    choose(&mut h, 0, "ui.vector.view.xray");
+    assert_eq!(photocraft_engine::vector_packages::isolation::authoritative_view(&h.state().session).unwrap().mode, crate::view_modes::Mode::Xray);
+    assert_eq!(menu_items(h.state()).iter().find(|i| i.id == "ui.vector.view.xray").unwrap().checked, Some(true));
+}
+
+#[test]
+fn compact_menu_pointer_then_arrows_reach_every_persona_root() {
+    for vector in [false, true] {
+        let tops = if vector { &VECTOR_TOP_MENUS[..] } else { &TOP_MENUS[..] };
+        for (index, title) in tops.iter().enumerate() {
+            let mut h = harness(vector, 760.0, true);
+            let root = h.get_by_label("Menu").rect();
+            assert!(h.ctx.content_rect().contains_rect(root));
+            h.get_by_label("Menu").click();
+            h.run_steps(3);
+            assert_eq!(crate::menu_nav::Nav::current(&h.ctx).rows[0].len(), tops.len());
+            for _ in 0..=index {
+                key(&mut h, egui::Key::ArrowDown);
+            }
+            let nav = crate::menu_nav::Nav::current(&h.ctx);
+            let selected = nav.highlighted(0).unwrap();
+            assert_eq!(selected, index, "{title}");
+            assert!(nav.views[0].expand(0.5).contains_rect(nav.rows[0][selected].rect), "{title} scrolls into view");
+            key(&mut h, egui::Key::ArrowRight);
+            assert!(crate::menu_nav::Nav::current(&h.ctx).rows.get(1).is_some_and(|rows| !rows.is_empty()), "{title} opens by keyboard");
+        }
+    }
+}
+
+#[test]
+fn compact_titlebar_menu_cannot_overlap_host_modes_or_caption() {
+    for theme in [crate::theme::ThemeKind::Studio, crate::theme::ThemeKind::StudioLight, crate::theme::ThemeKind::Classic] {
+        let mut app = app(true);
+        app.host_modes = true;
+        app.custom_titlebar = true;
+        let mut h = Harness::builder().with_size(egui::vec2(760.0, 480.0)).build_ui_state(|ui, app| crate::panels::title_bar(app, ui), app);
+        PhotocraftApp::setup_context(&h.ctx, theme);
+        h.run_steps(3);
+        let menu = h.get_by_label("Menu").rect();
+        for module in crate::Module::ALL {
+            let rect = h.ctx.data(|d| d.get_temp::<egui::Rect>(egui::Id::new(("host-mode-rect", module.digit())))).unwrap();
+            assert!(!menu.intersects(rect), "{theme:?} {module:?}");
+            assert!(h.ctx.content_rect().contains_rect(rect));
+        }
+        assert!(menu.right() < h.ctx.content_rect().right() - crate::titlebar::WIDTH);
+        h.get_by_label("Menu").click();
+        h.run_steps(3);
+        assert_eq!(crate::menu_nav::Nav::current(&h.ctx).rows[0].len(), VECTOR_TOP_MENUS.len());
+    }
+}

+#[test]
+fn reachable_locked_vector_commands_keep_raw_diagnostics_and_explain_the_next_action() {
+    let mut app = app(true);
+    app.run("shape.create", json!({"kind":"rect","rect":[4,4,24,24],"fill":"#ff0000"})).unwrap();
+    let id = app.session.active().unwrap().active_layer.unwrap();
+    app.session
+        .edit("lock fixture", |doc, _| {
+            doc.layer_mut(id).unwrap().locks.all = true;
+            Ok(())
+        })
+        .unwrap();
+    let ctx = egui::Context::default();
+    let before = app.session.active().unwrap().doc.clone();
+    let journal = app.session.journal.len();
+    for (command, raw) in [("ui.vector.transform.move", "transform target is locked"), ("ui.vector.path.offset", "Object command target is locked")] {
+        assert!(menu_items(&app).iter().any(|item| item.id == command && item.enabled), "actual reachable menu route");
+        assert_eq!(invoke_unguarded(&mut app, &ctx, command, json!({})).unwrap_err(), raw);
+        assert_eq!(invoke(&mut app, &ctx, command, json!({})).unwrap_err(), "Unlock the selected objects before editing them.");
+        app.automation_input = true;
+        assert_eq!(invoke(&mut app, &ctx, command, json!({})).unwrap_err(), raw);
+        app.automation_input = false;
+    }
+    assert_eq!(app.session.active().unwrap().doc, before);
+    assert_eq!(app.session.journal.len(), journal);
+}

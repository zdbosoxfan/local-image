+#[test]
+fn native_vector_tree_keeps_registered_roots_and_custom_shortcuts() {
+    let mut app = app(true);
+    app.session.edit_prefs(|p| {
+        p.shortcuts.insert("ui.vector.view.xray".into(), "Cmd+Alt+9".into());

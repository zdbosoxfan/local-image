+/// Reserve the actual host-mode labels plus the existing caption/workspace controls.
+/// The standalone bar has no host controls and uses all of its available width.
+pub fn menu_bar_in_titlebar(app: &mut PhotocraftApp, ui: &mut egui::Ui) -> f32 {
+    let modules = if app.host_modes {
+        crate::Module::ALL
+            .iter()
+            .map(|module| {
+                let text = egui::RichText::new(crate::i18n::t(module.label())).size(12.0);
+                let galley = egui::WidgetText::from(text).into_galley(ui, Some(egui::TextWrapMode::Extend), f32::INFINITY, egui::TextStyle::Button);
+                (galley.size().x + 2.0 * ui.spacing().button_padding.x).max(58.0)
+            })
+            .sum::<f32>()
+            + 8.0
+    } else {
+        0.0
+    };
+    let caption = if app.custom_titlebar { crate::titlebar::WIDTH + 4.0 } else { 0.0 };
+    // Workspace minimum, two existing icon slots and gaps; reserve before laying out menus.
+    let room = (ui.available_width() - modules - caption - 180.0).max(0.0);
+    menu_bar_with_width(app, ui, room)
+}
